{
  "info": {
    "name": "CVSPharmacy - Integración CU03 CU04 CU05 CU06",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Ejecutar en orden con API Development y usuario Administrador local configurado. Crea datos de práctica; no elimina datos existentes."
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://localhost:7257"
    },
    {
      "key": "run_id",
      "value": ""
    },
    {
      "key": "producto_id",
      "value": ""
    },
    {
      "key": "proveedor_id",
      "value": ""
    },
    {
      "key": "orden_id",
      "value": ""
    },
    {
      "key": "recepcion_id",
      "value": ""
    },
    {
      "key": "future_date",
      "value": ""
    },
    {
      "key": "expired_date",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 Crear producto",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/products",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"codigo\": \"PR-{{run_id}}\",\n  \"nombre\": \"Producto de práctica CU06\",\n  \"presentacion\": \"Caja\",\n  \"unidadMedida\": \"Unidad\",\n  \"precioVenta\": 10,\n  \"stockMinimo\": 40\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"run_id\", Date.now().toString());",
              "const future = new Date(); future.setFullYear(future.getFullYear() + 1);",
              "const expired = new Date(); expired.setDate(expired.getDate() - 1);",
              "pm.collectionVariables.set(\"future_date\", future.toISOString().slice(0, 10));",
              "pm.collectionVariables.set(\"expired_date\", expired.toISOString().slice(0, 10));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
              "if (pm.response.code === 201) pm.collectionVariables.set(\"producto_id\", pm.response.json().data.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Crear proveedor",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/suppliers",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nit\": \"{{run_id}}\",\n  \"razonSocial\": \"Proveedor de práctica\",\n  \"email\": \"practica@example.com\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
              "if (pm.response.code === 201) pm.collectionVariables.set(\"proveedor_id\", pm.response.json().data.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Crear orden de 50 unidades",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/purchase-orders",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"proveedorId\": {{proveedor_id}},\n  \"items\": [\n    {\n      \"productoId\": {{producto_id}},\n      \"cantidadSolicitada\": 50,\n      \"precioUnitario\": 5\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
